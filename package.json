{
  "name": "solid-quickstart",
  "description": "A quickstart template for Solid.js",
  "version": "0.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/timredd/solid-quickstart.git"
  },
  "author": "Tim Redd <tim@teod.io> (https://teod.io)",
  "keywords": [],
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/timredd/solid-quickstart/issues"
  },
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "deploy": "wrangler pages deploy ./dist",
    "dev:wrangler": "wrangler pages dev dist --live-reload",
    "db:start": "turso dev --db-file=local.db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env ./src/db/seed.ts",
    "db:init": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "preinstall": "npx only-allow pnpm",
    "preview": "wrangler pages dev ./dist",
    "test": "vitest",
    "types": "types:check",
    "types:build": "wrangler types ./src/env.d.ts && tsc --noEmit --pretty",
    "types:check": "tsc --noEmit",
    "ui": "pnpm dlx shadcn-solid@latest",
    "ui:add": "pnpm dlx shadcn-solid@latest add"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.5.2",
    "@kobalte/core": "^0.13.8",
    "@kobalte/tailwindcss": "^0.9.0",
    "@kobalte/utils": "^0.9.1",
    "@libsql/client": "^0.14.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@scalar/hono-api-reference": "^0.5.172",
    "@solidjs/router": "^0.15.3",
    "@solidjs/start": "^1.1.0",
    "@tailwindcss/vite": "^4.0.6",
    "@valibot/to-json-schema": "1.0.0-beta.3",
    "autoprefixer": "^10.4.20",
    "better-auth": "^1.1.17",
    "clsx": "^2.1.1",
    "cva": "1.0.0-beta.1",
    "drizzle-orm": "^0.39.3",
    "drizzle-seed": "^0.3.1",
    "drizzle-valibot": "^0.4.0",
    "hono": "^4.7.0",
    "hono-openapi": "^0.4.4",
    "lucide-solid": "^0.475.0",
    "nanoid": "^5.0.9",
    "solid-js": "^1.9.4",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.6",
    "valibot": "1.0.0-rc.0",
    "vinxi": "^0.5.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "^4.20250204.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.1",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.4",
    "jsdom": "^26.0.0",
    "solid-devtools": "^0.33.0",
    "tsx": "^4.19.2",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "3.0.5",
    "wrangler": "^3.107.3"
  },
  "engines": {
    "node": ">=18"
  }
}
